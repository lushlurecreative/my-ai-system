{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "MultiEdit(.claude/skills/**)",
      "MultiEdit(.claude/override.txt)",
      "MultiEdit(.claude/approvals.json)",
      "MultiEdit(.claude/discussion.json)",
      "MultiEdit(.claude/protected-edits.log)",
      "MultiEdit(.claude/unlocks.json)",
      "MultiEdit(.claude/pending.json)",
      "MultiEdit(.claude/system.json)",
      "MultiEdit(.claude/settings.json)",
      "MultiEdit(.claude/hooks/**)",
      "Write(.claude/skills/**)",
      "Write(.claude/override.txt)",
      "Write(.claude/approvals.json)",
      "Write(.claude/discussion.json)",
      "Write(.claude/protected-edits.log)",
      "Write(.claude/unlocks.json)",
      "Write(.claude/pending.json)",
      "Write(.claude/system.json)",
      "Write(.claude/settings.json)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/override.txt)",
      "Edit(.claude/approvals.json)",
      "Edit(.claude/discussion.json)",
      "Edit(.claude/protected-edits.log)",
      "Edit(.claude/unlocks.json)",
      "Edit(.claude/pending.json)",
      "Edit(.claude/system.json)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(PROTECTED.md)",
      "Write(PROTECTED.md)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Bash(git reset --hard*)",
      "mcp__Claude_Browser__*",
      "mcp__claude-in-chrome__*",
      "mcp__Control_Chrome__*",
      "mcp__plugin_browser-use_browser-use__*",
      "mcp__chrome-devtools__*",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__*",
      "mcp__next-devtools__browser_eval",
      "mcp__plugin_playwright_playwright__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 45
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/answer-first.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/approve.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*__send_message|mcp__.*__query_database|mcp__.*__execute_sql|mcp__.*__apply_migration|mcp__.*__run_sql",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protected-paths.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-model-floor.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/done-check.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
